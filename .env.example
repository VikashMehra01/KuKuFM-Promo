# Copy to .env and fill in the key for the provider you use in config.yaml.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternatives
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# For "custom:<model>" specs (any OpenAI-compatible endpoint, e.g. an interview-provided API)
LLM_BASE_URL=
LLM_API_KEY=

# Override config.yaml model specs without editing it, e.g. groq:llama-3.3-70b-versatile
# PROMO_GENERATOR=
# PROMO_JUDGE=
